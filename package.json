{
  "name": "google-docs-mermaid",
  "version": "0.1.0",
  "private": true,
  "description": "Local Mermaid previews for Google Docs",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "wxt": "^0.21.4"
  },
  "pnpm": {
    "overrides": {
      "@vitejs/plugin-react": "4.7.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
