{
  "name": "google-docs-mermaid",
  "version": "0.1.1",
  "private": true,
  "description": "Local Mermaid previews for Google Docs",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/generate-notices.mjs && wxt build",
    "zip": "node scripts/generate-notices.mjs && wxt zip && node scripts/check-package.mjs",
    "release:artifacts": "pnpm zip && node scripts/package-release.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm check:docs && pnpm typecheck && pnpm test",
    "postinstall": "wxt prepare",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.3",
    "marked": "^18.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "pnpm": {
    "overrides": {
      "@vitejs/plugin-react": "4.7.0",
      "mermaid>katex": "0.18.2"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
