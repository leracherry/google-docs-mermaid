{
  "name": "google-docs-mermaid",
  "version": "0.1.2",
  "private": true,
  "description": "Local Mermaid previews for Google Docs",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/generate-notices.mjs && wxt build",
    "zip": "node scripts/generate-notices.mjs && wxt zip && node scripts/check-package.mjs",
    "release:artifacts": "pnpm zip && node scripts/package-release.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm check:docs && pnpm typecheck && pnpm test",
    "postinstall": "wxt prepare",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.3",
    "marked": "^18.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
